---
source: lurklet-api/src/app.rs
expression: document
---
{
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "health": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "health"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok"
        ],
        "type": "string"
      },
      "NamedReference": {
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "Post": {
        "properties": {
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/PostAttachment"
            },
            "type": "array"
          },
          "author": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NamedReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "bodyMarkdown": {
            "description": "Untrusted Markdown; embedded media URLs are not proxied.",
            "type": [
              "string",
              "null"
            ]
          },
          "commentCount": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "community": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NamedReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "crosspostId": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "isNsfw": {
            "type": "boolean"
          },
          "isSpoiler": {
            "type": "boolean"
          },
          "score": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "community",
          "createdAt",
          "score",
          "commentCount",
          "isNsfw",
          "isSpoiler",
          "bodyMarkdown",
          "attachments",
          "crosspostId"
        ],
        "type": "object"
      },
      "PostAttachment": {
        "oneOf": [
          {
            "properties": {
              "kind": {
                "enum": [
                  "link"
                ],
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "altText": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "caption": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "image"
                ],
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "altText",
              "caption",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "video"
                ],
                "type": "string"
              },
              "posterUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sources": {
                "items": {
                  "$ref": "#/components/schemas/VideoSource"
                },
                "type": "array"
              }
            },
            "required": [
              "sources",
              "posterUrl",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "Problem": {
        "properties": {
          "status": {
            "format": "int32",
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "VideoFormat": {
        "enum": [
          "mp4",
          "hls",
          "dash"
        ],
        "type": "string"
      },
      "VideoSource": {
        "properties": {
          "format": {
            "$ref": "#/components/schemas/VideoFormat"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "format"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Internal API contract. API requests share a per-client rate limit, except for /api/health. Excess requests return 429 Problem Details with Retry-After. Unknown API paths return 404 Problem Details unless rate limited.",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "AGPL-3.0-only"
    },
    "title": "Lurklet API",
    "version": "0.1.0"
  },
  "openapi": "3.2.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The API is serving requests"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The method is not supported",
            "headers": {
              "Allow": {
                "description": "GET,HEAD",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Check API liveness without contacting upstream services"
      }
    },
    "/api/posts/{id}": {
      "get": {
        "operationId": "get_post",
        "parameters": [
          {
            "description": "Post ID, as returned by the API.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            },
            "description": "A readable post"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method Not Allowed",
            "headers": {
              "Allow": {
                "description": "Supported HTTP methods",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the client may retry",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Retry-After": {
                "description": "Upstream retry delay or HTTP date, when supplied",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Retrieve one post without comments or related posts"
      }
    }
  }
}
