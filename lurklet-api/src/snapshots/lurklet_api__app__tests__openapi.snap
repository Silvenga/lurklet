---
source: lurklet-api/src/app.rs
expression: document
---
{
  "components": {
    "schemas": {
      "Comment": {
        "properties": {
          "author": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CommentAuthor"
              },
              {
                "type": "null"
              }
            ]
          },
          "bodyMarkdown": {
            "description": "Untrusted Markdown; embedded media URLs are not proxied.",
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "initiallyCollapsed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "isOp": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "isPinned": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "score": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/CommentState"
          }
        },
        "required": [
          "id",
          "state",
          "author",
          "createdAt",
          "bodyMarkdown",
          "score",
          "isOp",
          "isPinned",
          "initiallyCollapsed"
        ],
        "type": "object"
      },
      "CommentAuthor": {
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "CommentForest": {
        "description": "Ordered discussion roots, or replacement items for one selected placeholder.",
        "properties": {
          "appliedSort": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CommentSort"
              },
              {
                "type": "null"
              }
            ]
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CommentItem"
            },
            "type": "array"
          }
        },
        "required": [
          "appliedSort",
          "items"
        ],
        "type": "object"
      },
      "CommentItem": {
        "oneOf": [
          {
            "properties": {
              "comment": {
                "$ref": "#/components/schemas/Comment"
              },
              "kind": {
                "enum": [
                  "comment"
                ],
                "type": "string"
              },
              "replies": {
                "items": {
                  "$ref": "#/components/schemas/CommentItem"
                },
                "type": "array"
              }
            },
            "required": [
              "comment",
              "replies",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "countHint": {
                "description": "Upstream hint, not an exact count.",
                "format": "int64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cursor": {
                "description": "Opaque cursor for replacing this placeholder; null means no action is available.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "more"
                ],
                "type": "string"
              }
            },
            "required": [
              "cursor",
              "countHint",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "commentId": {
                "description": "Anchor for the thread endpoint; null means no action is available.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "continueThread"
                ],
                "type": "string"
              }
            },
            "required": [
              "commentId",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "CommentSort": {
        "default": "best",
        "enum": [
          "best",
          "top",
          "new"
        ],
        "type": "string"
      },
      "CommentState": {
        "enum": [
          "present",
          "deleted",
          "removed"
        ],
        "type": "string"
      },
      "CommentThread": {
        "properties": {
          "forest": {
            "$ref": "#/components/schemas/CommentForest"
          },
          "postId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "postId",
          "forest"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "health": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "health"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok"
        ],
        "type": "string"
      },
      "ListedPost": {
        "properties": {
          "authorName": {
            "type": [
              "string",
              "null"
            ]
          },
          "commentCount": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "isNsfw": {
            "type": "boolean"
          },
          "isPinned": {
            "type": "boolean"
          },
          "isSpoiler": {
            "type": "boolean"
          },
          "score": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "thumbnail": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Thumbnail"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "thumbnail",
          "score",
          "commentCount",
          "authorName",
          "createdAt",
          "isNsfw",
          "isSpoiler",
          "isPinned"
        ],
        "type": "object"
      },
      "NamedReference": {
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "Post": {
        "properties": {
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/PostAttachment"
            },
            "type": "array"
          },
          "author": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NamedReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "bodyMarkdown": {
            "description": "Untrusted Markdown; embedded media URLs are not proxied.",
            "type": [
              "string",
              "null"
            ]
          },
          "commentCount": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "community": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/NamedReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "crosspostId": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "isNsfw": {
            "type": "boolean"
          },
          "isSpoiler": {
            "type": "boolean"
          },
          "score": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "community",
          "createdAt",
          "score",
          "commentCount",
          "isNsfw",
          "isSpoiler",
          "bodyMarkdown",
          "attachments",
          "crosspostId"
        ],
        "type": "object"
      },
      "PostAttachment": {
        "oneOf": [
          {
            "properties": {
              "kind": {
                "enum": [
                  "link"
                ],
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "altText": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "caption": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "image"
                ],
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "altText",
              "caption",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "video"
                ],
                "type": "string"
              },
              "posterUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sources": {
                "items": {
                  "$ref": "#/components/schemas/VideoSource"
                },
                "type": "array"
              }
            },
            "required": [
              "sources",
              "posterUrl",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "Problem": {
        "properties": {
          "status": {
            "format": "int32",
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "SubredditPage": {
        "properties": {
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "posts": {
            "items": {
              "$ref": "#/components/schemas/ListedPost"
            },
            "type": "array"
          }
        },
        "required": [
          "posts",
          "nextCursor"
        ],
        "type": "object"
      },
      "Thumbnail": {
        "properties": {
          "height": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "isObfuscated": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "obfuscatedUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "width": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "url",
          "obfuscatedUrl",
          "isObfuscated",
          "width",
          "height"
        ],
        "type": "object"
      },
      "VideoFormat": {
        "enum": [
          "mp4",
          "hls",
          "dash"
        ],
        "type": "string"
      },
      "VideoSource": {
        "properties": {
          "format": {
            "$ref": "#/components/schemas/VideoFormat"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "format"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Internal API contract. API requests share a per-client rate limit, except for /api/health. Excess requests return 429 Problem Details with Retry-After. Unknown API paths return 404 Problem Details unless rate limited.",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "AGPL-3.0-only"
    },
    "title": "Lurklet API",
    "version": "0.1.0"
  },
  "openapi": "3.2.0",
  "paths": {
    "/api/comments/{id}/thread": {
      "get": {
        "description": "The forest may include ancestors of the requested comment. It is not an inline replacement fragment, and further expansion in this view is not supported.",
        "operationId": "get_comment_thread",
        "parameters": [
          {
            "description": "Comment ID, including an anchor returned by a continueThread placeholder.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "best",
              "enum": [
                "best",
                "top",
                "new"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentThread"
                }
              }
            },
            "description": "Thread context and its post reference"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method Not Allowed",
            "headers": {
              "Allow": {
                "description": "Supported HTTP methods",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the client may retry",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Retry-After": {
                "description": "Upstream retry delay or HTTP date, when supplied",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Open a comment thread with ancestor context"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The API is serving requests"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The method is not supported",
            "headers": {
              "Allow": {
                "description": "GET,HEAD",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Check API liveness without contacting upstream services"
      }
    },
    "/api/posts/{id}": {
      "get": {
        "operationId": "get_post",
        "parameters": [
          {
            "description": "Post ID, as returned by the API.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            },
            "description": "A readable post"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method Not Allowed",
            "headers": {
              "Allow": {
                "description": "Supported HTTP methods",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the client may retry",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Retry-After": {
                "description": "Upstream retry delay or HTTP date, when supplied",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Retrieve one post without comments or related posts"
      }
    },
    "/api/posts/{id}/comments": {
      "get": {
        "description": "Without a cursor, returns the initial forest. With a cursor, the returned items replace only the selected placeholder, not the whole discussion.",
        "operationId": "get_post_comments",
        "parameters": [
          {
            "description": "Post ID, as returned by the API.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "best",
              "enum": [
                "best",
                "top",
                "new"
              ],
              "type": "string"
            }
          },
          {
            "description": "Pass a selected placeholder's cursor unchanged with the same post and requested sort.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentForest"
                }
              }
            },
            "description": "Ordered comments and expansion placeholders"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method Not Allowed",
            "headers": {
              "Allow": {
                "description": "Supported HTTP methods",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the client may retry",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Retry-After": {
                "description": "Upstream retry delay or HTTP date, when supplied",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Read a post's comments or expand one selected placeholder"
      }
    },
    "/api/subreddits/{subreddit}/posts": {
      "get": {
        "operationId": "list_subreddit_posts",
        "parameters": [
          {
            "description": "Community name, without the r/ prefix.",
            "in": "path",
            "name": "subreddit",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "hot",
              "enum": [
                "hot",
                "new",
                "top"
              ],
              "type": "string"
            }
          },
          {
            "description": "Only valid with top sorting; defaults to all.",
            "in": "query",
            "name": "timeRange",
            "required": false,
            "schema": {
              "enum": [
                "hour",
                "day",
                "week",
                "month",
                "year",
                "all"
              ],
              "type": "string"
            }
          },
          {
            "description": "Pass nextCursor unchanged with the same subreddit, sort, and time range.",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubredditPage"
                }
              }
            },
