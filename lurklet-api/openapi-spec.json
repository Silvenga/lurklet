{
  "openapi": "3.2.0",
  "info": {
    "title": "Lurklet API",
    "description": "Internal API contract. API requests share a per-client rate limit, except for /api/health. Excess requests return 429 Problem Details with Retry-After. Unknown API paths return 404 Problem Details unless rate limited. API responses default to Cache-Control: no-store unless a resource explicitly opts into caching.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Check API liveness without contacting upstream services",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "The API is serving requests",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "Always no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "405": {
            "description": "The method is not supported",
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                },
                "description": "GET,HEAD"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "Always no-store"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["health"],
        "properties": {
          "health": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": ["ok"]
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32",
            "maximum": 599,
            "minimum": 100
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    }
  }
}
