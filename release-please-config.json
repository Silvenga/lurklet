{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": ".version",
      "initial-version": "0.1.0",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.dependencies['lurklet-reddit'].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'lurklet-api' || @.name.value == 'lurklet-reddit' || @.name.value == 'lurklet-reddit-cli')].version"
        },
        "package.json",
        "lurklet-web/package.json"
      ]
    }
  }
}
