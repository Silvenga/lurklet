{
  "name": "lurklet",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm --filter lurklet-web build",
    "publish:web": "pnpm run build && pnpm --filter lurklet-web compress",
    "dev": "pnpm --filter lurklet-web dev",
    "dev:mock": "pnpm --filter lurklet-web dev --mode mock",
    "generate:api": "pnpm --filter lurklet-web generate:api",
    "postinstall": "pnpm generate:api",
    "test": "pnpm --filter lurklet-web test",
    "lint": "tsc -b && oxlint",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
